      </assemblies>
    </compilation>
    <httpRuntime maxRequestLength="1073741824" executionTimeout="3000" targetFramework="4.5" requestValidationMode="2.0"/>
    <pages validateRequest="false"/>
    <!--<sessionState cookieless="true" mode="SQLServer" allowCustomSqlDatabase="true" sqlConnectionString="artworldConnectionString"></sessionState>-->
    <!--<sessionState mode="StateServer" stateConnectionString="tcpip=127.0.0.1:42424">-->
    <!--</sessionState>-->
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <remove name="OPTIONSVerbHandler"/>
      <remove name="TRACEVerbHandler"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
    </handlers>
    <security>
      <requestFiltering>
        <!-- maxAllowedContentLength, for IIS, in bytes -->
        <requestLimits maxAllowedContentLength="1073741824"/>
      </requestFiltering>
    </security>
  </system.webServer>
