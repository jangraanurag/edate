<configuration>
  <connectionStrings>
    <add name="edateConnectionString" connectionString="Data Source=edateworld.com;Initial Catalog=edate_db;User ID=edate_usr;Password=Anurag@1990" providerName="System.Data.SqlClient"/>
    <!--<add name="edateConnectionString" connectionString="Data Source=edateredhot.com;Initial Catalog=edateredhot_db;User ID=edateredhot_usr;Password=Anurag@1990" providerName="System.Data.SqlClient"/>-->
